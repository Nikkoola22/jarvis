# Variables d'environnement pour JARVIS sur Vercel
# À ajouter dans votre projet Vercel (Settings -> Environment Variables) ou dans .env en local

# Clé API Z.ai (Obligatoire pour les appels serveur)
# Obtenez votre clé sur https://z.ai ou le portail Zhipu AI
ZAI_API_KEY=votre_cle_api_z_ai_ici

# Modèle d'intelligence Z.ai (Par défaut : glm-4-flash)
# Options : glm-4-flash, glm-4, glm-5.3, glm-5.3-flash
ZAI_MODEL=glm-4-flash

# Base URL Z.ai (Optionnel, par défaut : https://api.z.ai/api/paas/v4)
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
